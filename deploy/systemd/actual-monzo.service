[Unit]
Description=Import Monzo transactions into Actual Budget
Documentation=https://github.com/VideoScape/actual-monzo
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'exec /usr/local/bin/actual-monzo --no-color import >>/var/log/actual-monzo/import.log 2>&1'
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
LogsDirectory=actual-monzo
