[Unit]
Description=Import Monzo transactions into Actual Budget
Documentation=https://github.com/VideoScape/actual-monzo
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/actual-monzo --no-color import
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
LogsDirectory=actual-monzo
StandardOutput=append:/var/log/actual-monzo/import.log
StandardError=append:/var/log/actual-monzo/import.log
